  "extraction": {
    "independent_extractors": 2,
    "blind_to_other_extraction": true,
    "each_extractor_recalibrates_axes": true,
    "tool_name_version_and_annotation_artifact_required": true,
    "blindness_attestation_required": true,
    "distinct_workflow_and_annotation_digest_required": true,
    "raw_extractions_are_immutable": true,
    "single_extractor_values_can_promote": false
  },
  "axis_calibration": {
    "model": "independent_affine_pixel_to_display_coordinate_transform_per_axis",
    "scale": "the display coordinate is the printed linear value or log10(value), exactly as declared per panel",
    "minimum_legible_ticks_per_axis": 3,
    "use_all_legible_major_ticks": true,
    "outermost_ticks_required": true,
    "minimum_calibrated_axis_span_fraction": 0.75,
    "tick_coordinate": "center_of_tick_axis_intersection",
    "tick_value_authority": "printed_label",
    "tick_pixel_region_minimum_half_width": 0.5,
    "tick_pixel_region_maximum_half_width": 8.0,
    "fit_method": "Monte_Carlo_pixel_errors_then_affine_least_squares",
    "axis_fit_residual_model": "independent_zero_mean_normal_in_display_coordinates_with_sigma_equal_to_nominal_rms_axis_residual",
    "acceptance": {
      "maximum_standardized_anchor_residual": 2.0,
      "monotonic_transform_required": true,
      "all_tick_inverse_checks_required": true
    },
    "record": [
      "axis_anchor_center_regions",
      "rms_pixels",
      "maximum_pixels",
      "rms_axis_units",
      "maximum_axis_units"
    ]
  },
  "point_measurement": {
    "command_id_rule": "sort markers by calibrated x value ascending and assign command_001, command_002, and so on",
    "x_authority": "published_command_when_explicit",
    "operational_partition_is_not_command_authority": true,
    "x_role_by_mode": {
      "published_command": "command_identity_and_calibration_check",
      "digitized_source_marker": "numeric_source_measurement_with_digitization_uncertainty"
    },
    "y_coordinate": "marker_center",
    "marker_center_record": "rectangle_covering_all_plausible_center_pixels",
    "marker_center_minimum_half_width_pixels": 0.5,
    "marker_center_maximum_half_width_pixels": 12.0,
    "partial_occlusion_requires": [
      "unique_series_identity",
      "at_least_two_opposing_marker_edges",
      "bounded_center_without_curve_interpolation"
    ],
    "point_or_line_interpolation_allowed": false
  },
  "error_bars": {
    "published_uncertainty_kind_required": true,
    "extract_each_visible_endpoint_separately": true,
    "hidden_endpoint_inference_allowed": false,
    "endpoint_center_maximum_half_width_pixels": 12.0,
    "endpoint_x_region_must_overlap_marker_x_region": true,
    "preserve_one_sided_bars": true,
    "mean_may_remain_available_when_bar_is_unavailable": true
  },
  "digitization_uncertainty": {
    "monte_carlo_draws": 100000,
    "deterministic_seed_fields": [
      "asset_sha256",
      "panel_id",
      "series_id",
      "command_id"
    ],
    "per_extractor_components": [
      "axis_anchor_center_regions",
      "marker_or_endpoint_center_region",
      "axis_fit_residuals"
    ],
    "combine_extractors": "equal_weight_mixture",
    "pixel_region_distribution": "independent_continuous_uniform_within_each_preregistered_rectangle",
    "axis_residual_distribution": "independent_zero_mean_normal_in_display_coordinates",
    "report": [
      "median",
      "standard_uncertainty",
      "q025",
      "q975",
      "axis_calibration_component",
      "marker_or_endpoint_component",
      "between_extractor_component"
    ]
  },
  "biological_uncertainty": {
    "stored_separately_from_digitization_uncertainty": true,
    "digitization_uncertainty_must_not_be_called_sem": true,
    "published_asymmetric_bars_preserved": true,
    "downstream_interval": "propagate digitized mean and visible error-bar endpoint distributions into the preregistered decision interval",
    "downstream_interval_label": "decision_interval_with_digitization"
  },
  "agreement_and_adjudication": {
    "statistic": "absolute_difference_divided_by_sqrt(u1_squared_plus_u2_squared)",
    "threshold": 2.0,
    "failure_action": "third_blind_independent_extraction",
    "retain_all_original_extractions": true,
    "consensus_overwrites_raw_extractions": false
  },
  "unavailable_if": [
    "asset digest or original dimensions mismatch",
    "panel, axis, unit, or series identity is ambiguous",
    "fewer than three usable ticks exist on either axis",
    "calibration acceptance fails",
    "marker is absent and only a line is visible",
    "overlap prevents unique series assignment",
    "occlusion prevents a bounded marker center",
    "digitized x conflicts with the authoritative command",
    "error-bar endpoint is not distinguishable",
    "duplicate extractions disagree and adjudication cannot resolve the feature"
  ],
  "promotion_gate": {
    "requires": [
      "two accepted independent extractions",
      "accepted calibration",
      "available population mean",
      "identified biological uncertainty type for every used error bar",
      "held-out custody materialized after extraction and before optimization"
    ],
    "held_out_values_visible_to_proposal_generation": false,
    "missing_or_unavailable_commands_are_imputed": false,
    "optimization_remains_blocked_until_verified_target_packet": true
  },
