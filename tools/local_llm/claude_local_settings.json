      "Bash(bash tools/local_llm/llm.sh status)",
      "Bash(systemctl --user status:*)",
      "Bash(systemctl --user is-active:*)",
      "Bash(systemctl --user restart pool-dispatch)",
      "Bash(systemctl --user restart pool-sync)",
      "Bash(.venv/bin/python tools/battery_status.py:*)",
      "Bash(.venv/bin/python tools/check_docs.py)",
      "Bash(.venv/bin/python -m research.runners._affect_marker_settle_congruence --score-wiring:*)",
