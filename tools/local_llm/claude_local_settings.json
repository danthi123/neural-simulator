      "Bash(git reset --hard:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(aws:*)",
      "Bash(bash tools/aws_pool_node.sh:*)",
      "Bash(bash tools/aws_gpu.sh:*)",
      "Bash(sudo:*)",
      "Edit(sim/**)",
