      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git restore --staged:*)",
      "Bash(git commit -m:*)",
      "Bash(git commit -q -m:*)",
      "Bash(git switch -c research/draft-:*)",
