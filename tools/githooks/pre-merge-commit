#!/usr/bin/env bash
# pre-merge-commit: BLOCK a merge commit that violates the document-structure rules (docs/WRITING.md W1 + W2).
#
# WHY (2026-09-24). Auto-committed merges (via git merge --no-edit or --no-verify)
# can silently bypass every gate, including the pre-commit hook that is REQUIRED for all manual commits.
# This hook ensures that merge commits run the same document-structure checks before they land on the
# target branch. NOTE: clean cherry-pick (with no conflict) does NOT trigger this hook; only a real
# non-fast-forward merge does. A conflicted cherry-pick that is finalized via explicit git commit
# goes through pre-commit (not this hook).
#
# Install:  git config core.hooksPath tools/githooks (absolute paths or trailing slashes are also valid)
# Bypass (deliberate, visible in the reflog):  git merge --no-verify <branch> or git commit --no-verify
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel); export ROOT
COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 1
CANONICAL=$(dirname "$COMMON")

# Verify that core.hooksPath is correctly set to tools/githooks
HOOKS_PATH=$(git config core.hooksPath 2>/dev/null || echo "")
# Normalize the path: handle both relative (tools/githooks), absolute, and trailing slashes
NORMALIZED_HOOKS="${HOOKS_PATH%/}"  # Remove trailing slash if present
# $ROOT is THIS checkout's own toplevel -- in a LINKED WORKTREE that is the worktree's own path, not the
# primary checkout core.hooksPath's absolute form was configured against (core.hooksPath is repo-common
# config, so every worktree shares the one value, typically an absolute path into the primary checkout).
# $CANONICAL (dirname of --git-common-dir) is that primary checkout's root regardless of which worktree is
# running. Accept either so a worktree merge is not blocked on a false mismatch (found 2026-09-29 landing
# host-share-baselines: ROOT-only comparison rejected the correctly-configured shared absolute path).
if [ -z "$NORMALIZED_HOOKS" ] || ! { [ "$NORMALIZED_HOOKS" = "tools/githooks" ] || [ "$NORMALIZED_HOOKS" = "$ROOT/tools/githooks" ] || [ "$NORMALIZED_HOOKS" = "$CANONICAL/tools/githooks" ]; }; then
  echo "⛔ pre-merge-commit: git config core.hooksPath is '$HOOKS_PATH'."
  echo "   It should be either 'tools/githooks' (relative) or the absolute path to tools/githooks."
  echo "   Run: git config core.hooksPath tools/githooks"
  exit 1
fi

# Exec the pre-commit hook to run document-structure checks. Prefer the canonical (primary-checkout) copy,
# since that is what an absolute core.hooksPath actually points at from any worktree; fall back to $ROOT for
# the relative "tools/githooks" form (git itself resolves that against $ROOT before this script ever runs).
if [ -x "$CANONICAL/tools/githooks/pre-commit" ]; then
  exec "$CANONICAL/tools/githooks/pre-commit"
fi
exec "$ROOT/tools/githooks/pre-commit"
