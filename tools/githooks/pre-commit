#!/usr/bin/env bash
# pre-commit: the lean check set (2026-11-02). Every check here reads THIS commit's own content, is cheap
# (whole hook <= ~5 s on a typical commit), and guards against irreversible/costly harm or an invalid claim.
# The list and the reasons: docs/FAILURE_GATE_MATRIX.md. Retired checks: docs/archive/2026-11-02-gate-inventory.md.
# Same hook for every driver (Claude, Hermes, Pi). Never bypass with --no-verify.
#
# Install:  git config core.hooksPath tools/githooks
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel); export ROOT
COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 1
CANONICAL=$(dirname "$COMMON")
OUT=$(mktemp -d); trap 'rm -r -- "${OUT:?}"' EXIT

# 1. AGENT MERGE BACKSTOP (owner ruling 2026-10-01). The server driver (uid 99) may commit on main only the routine
# classes in tools/agent_merge_policy.py. A Claude review session on the server sets SIM_CLAUDE_REVIEW=1.
if [ "$(id -u)" = 99 ] && [ "$(git branch --show-current)" = main ] && [ "${SIM_CLAUDE_REVIEW:-0}" != 1 ] \
   && [ -f "$ROOT/tools/agent_merge_policy.py" ]; then
  python3 "$ROOT/tools/agent_merge_policy.py" --staged || exit 1
fi
PY=${SIM_ENGINE_PYTHON:-$CANONICAL/.venv/bin/python}
if [ ! -x "$PY" ]; then
  echo "COMMIT BLOCKED: canonical engine interpreter missing: $PY"
  exit 1
fi

ADDED=$(git diff --cached --name-only --diff-filter=A)
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)
NEWF=$(printf '%s\n' "$ADDED" | grep -E '^research/findings/[^/]+\.md$' || true)

# 2. NEW FINDING DECLARES A STATUS, so retrieval can tell a live result from a void one.
if [ -n "$NEWF" ]; then
  BAD=""
  for f in $NEWF; do
    head -1 "$f" 2>/dev/null | grep -q '^---$' && grep -qE '^status:[[:space:]]*[a-z-]+' "$f" || BAD="$BAD $f"
  done
  if [ -n "$BAD" ]; then
    echo "⛔ COMMIT BLOCKED: new finding(s) without frontmatter status:$BAD"
    echo "   First lines:  ---  /  status: live | qualified | corrected | superseded | retracted  /  date: YYYY-MM-DD  /  ---"
    exit 1
  fi
fi

# 3. CLAIMS TRACE TO ARTIFACTS. Every measurement in a new finding must exist in an artifact it cites. During a
# merge, findings carried byte-identical from a parent are dropped (tools/merge_carried.py, fails closed).
_MH=$(git rev-parse --path-format=absolute --git-path MERGE_HEAD 2>/dev/null || true)
if [ -n "$NEWF" ] && [ -n "$_MH" ] && [ -f "$_MH" ]; then
  _KEEP=$(printf '%s\n' "$NEWF" | "$PY" "$ROOT/tools/merge_carried.py") && NEWF=$_KEEP
fi
if [ -n "$NEWF" ]; then
  if ! printf '%s\n' "$NEWF" | xargs -r "$PY" "$ROOT/tools/claim_check.py" > "$OUT/claims" 2>&1; then
    echo "⛔ COMMIT BLOCKED: a new finding states measurements that are in no artifact it cites:"
    sed 's/^/   /' "$OUT/claims" | tail -20
    echo "   Fix: cite the artifact (a path with a /), save and cite the aggregate, or mark a derived value <!--derived-->."
    exit 1
  fi
fi

# 4. BIOLOGY BINDINGS (only when the commit touches the bindings or the code they bind): source pointers resolve
# and no config contradicts the biology it implements.
if printf '%s\n' "$CHANGED" | grep -qE '^(research/biology/|research/runners/|sim/)'; then
  if ! "$PY" "$ROOT/tools/biology_check.py" > "$OUT/bio" 2>&1; then
    echo "⛔ COMMIT BLOCKED: biology binding failed:"
    sed 's/^/   /' "$OUT/bio" | tail -15
    exit 1
  fi
fi

# 5. THE GATE REGISTRY (tools/gates/*.py, auto-discovered; each gate's selftest must fail in the failing direction
# before its verdict is trusted). Paths go through a file: argv overflows on large artifact commits.
printf '%s\n' "$ADDED" > "$OUT/paths"
"$PY" - "$OUT/paths" > "$OUT/gates" 2>&1 <<'PY'
import sys, os
sys.path.insert(0, os.environ.get("ROOT") or os.getcwd())
from tools.gates import run_all
paths = [p for p in open(sys.argv[1]).read().split("\n") if p.strip()]
blocking, report = run_all(paths, verbose=False)
print("\n".join(report))
sys.exit(1 if blocking else 0)
PY
if [ $? -ne 0 ]; then
  echo "⛔ COMMIT BLOCKED by gate(s):"
  sed 's/^/   /' "$OUT/gates" | tail -30
  exit 1
fi
grep -E "⚠️" "$OUT/gates" | head -6 | sed 's/^/   /'
exit 0
