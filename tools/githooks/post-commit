#!/usr/bin/env bash
# RAG auto-update post-commit hook (armed through core.hooksPath=tools/githooks).
# When a commit touches the prose knowledge base, fire a BACKGROUND, DEBOUNCED update of BOTH RAG indexes
# (LlamaIndex + SOMA) via tools/rag/update_indexes.py. Non-blocking: the commit returns immediately.
# update_indexes.py is lock-guarded + manifest-gated, so a burst of commits collapses to one update and an
# unchanged corpus is a no-op. Idempotent + safe to fire on every commit.
# SOMA is optional -- update_indexes.py catches its ImportError and still refreshes LlamaIndex.

changed=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null)
if echo "$changed" | grep -qE '^(research/findings/|docs/|CLAUDE\.md|ROADMAP\.md|README\.md)'; then
  REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
  COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
  CANONICAL=$(dirname "$COMMON")
  ROOT="${SIM_RAG_ROOT:-$(dirname "$CANONICAL")/rag_index}"
  PY="${SIM_RAG_PYTHON:-$CANONICAL/.venv-rag/bin/python}"
  UPD="$REPO/tools/rag/update_indexes.py"
  LOG="$ROOT/_autoupdate.log"
  mkdir -p "$ROOT"
  if [ ! -x "$PY" ]; then
    printf '[post-commit] BLOCKED: RAG interpreter missing: %s\n' "$PY" >> "$LOG"
    exit 0
  fi
  BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || printf detached)
  if [ "$BRANCH" != "${SIM_RAG_REFRESH_BRANCH:-main}" ]; then
    printf '[post-commit] SKIP: branch=%s; canonical refresh branch=%s\n' \
      "$BRANCH" "${SIM_RAG_REFRESH_BRANCH:-main}" >> "$LOG"
    exit 0
  fi
  if ! grep -q '"document_id_schema"[[:space:]]*:[[:space:]]*"repo-relative-v1"' "$ROOT/.rag_schema.json" 2>/dev/null; then
    printf '[post-commit] BLOCKED: legacy/missing index schema; run tools/rag/update_indexes.py --rebuild\n' >> "$LOG"
    exit 0
  fi
  # Sleep briefly so a burst of commits collapses into one update (the lock+manifest gate does the rest), then update.
  # nohup protects against a non-interactive parent sending SIGHUP; detached stdin and a new session keep the updater
  # independent of the committing terminal/process group. The delay override exists for deterministic integration tests.
  DELAY=${SIM_RAG_REFRESH_DELAY:-45}
  DETACH=()
  command -v setsid >/dev/null 2>&1 && DETACH=(setsid --fork)
  printf '[post-commit] START: branch=%s source=%s delay=%ss\n' "$BRANCH" "$REPO" "$DELAY" >> "$LOG"
  nohup "${DETACH[@]}" sh -c '
    delay=$1
    repo=$2
    python=$3
    updater=$4
    log=$5
    sleep "$delay"
    SIM_REPO="$repo" "$python" "$updater"
    status=$?
    printf "[post-commit] EXIT: status=%s source=%s\n" "$status" "$repo" >> "$log"
    exit "$status"
  ' rag-refresh "$DELAY" "$REPO" "$PY" "$UPD" "$LOG" </dev/null >> "$LOG" 2>&1 &
fi
exit 0
