[Unit]
Description=Hermes v2 autonomous research loop (per-turn sessions, run-status tracked, VRAM handoff)
After=default.target hermes-gateway.service

[Service]
Type=simple
WorkingDirectory=/home/dant123/Projects/sim
Environment=HERMES_LOOP_REASONING=medium
ExecStart=/usr/bin/python3 /home/dant123/Projects/sim/tools/hermes/loop.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
