[Service]
Type=oneshot
User=dant123
Group=dant123
WorkingDirectory=/home/dant123/Projects/sim
Environment=HOME=/home/dant123
ExecStart=/usr/bin/bash -c 'bash tools/aws_idle_stop.sh; bash tools/aws_budget.sh enforce'
