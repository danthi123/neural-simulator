# /etc/systemd/system/sim-agent-update.service -- weekly sim-agent rebuild + smoke test + safe swap
# (tools/agent_container/update.sh). Same shape as apps-gitsync.service: a system unit running as dant123.
# Source of truth: neural-simulator repo, tools/agent_container/server-stack/host/etc/systemd/system/.
# update.sh exits non-zero only when the owner should look (a failed build or smoke test, a dirty build source,
# the firewall unit down); a deferral (busy or paused agent) is a success, so OnFailure alerts stay meaningful.
[Unit]
Description=sim-agent weekly rebuild, smoke test and safe swap
After=network-online.target docker.service sim-agent-fw.service
Wants=network-online.target
OnFailure=ntfy-notify@%n.service

[Service]
Type=oneshot
User=dant123
Environment=HOME=/home/dant123
WorkingDirectory=/home/dant123/apps
ExecStart=/usr/bin/bash /home/dant123/data/sim-agent/src/tools/agent_container/update.sh
