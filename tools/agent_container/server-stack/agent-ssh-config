# ~/.ssh/config INSIDE the sim-agent container (host path: ${DATA_ROOT}/sim-agent/home/.ssh/config, owned
# 61000:61000, mode 600). Installed by the owner from the host side -- see docs/AGENT_HARNESS_SETUP.md.
# Source of truth: neural-simulator repo, tools/agent_container/server-stack/agent-ssh-config. No secrets here.
#
# Every destination below is one sim-agent.nft allows; anything else is dropped at the host. Host keys are
# pinned (StrictHostKeyChecking yes + known_hosts the owner seeds), so a LAN impostor cannot answer as either host.

Host *
    BatchMode yes
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    UserKnownHostsFile ~/.ssh/known_hosts
    ConnectTimeout 10
    ServerAliveInterval 30

# the workstation's restricted gateway (forced command tools/agent_gateway.sh)
Host workstation-gateway
    HostName 192.168.0.68
    User dant123
    IdentityFile ~/.ssh/id_ed25519

# the workstation's read-only results pull (forced command rrsync -ro -no-del .../research/findings/raw)
Host results-sync-gateway
    HostName 192.168.0.68
    User dant123
    IdentityFile ~/.ssh/id_ed25519_results_sync

# gitea git-over-ssh: THIS host's LAN address + published 2222 (Docker DNATs it to gitea:22). Never
# git.dant123.com: that resolves to the WAN address, and the hairpin back through the router is dropped.
Host gitea-deploy
    HostName 192.168.0.10
    Port 2222
    User git
    IdentityFile ~/.ssh/id_ed25519_gitea
