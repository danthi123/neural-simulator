# Backend profile: Unsloth Studio (installed via the official `curl -fsSL https://unsloth.ai/install.sh | sh
# -- --no-torch`, CLI-only / no GUI needed for serving: --no-torch skips PyTorch/training deps since this repo
# only SERVES a GGUF through Unsloth's bundled prebuilt llama.cpp backend). Install lives in
# ~/.unsloth/studio/unsloth_studio (its own venv); launch shortcut/binary: `unsloth`.
#   set -a; source tools/agent_container/profiles/unsloth-studio.env; set +a
#
# START (GPU job -- queue it, see tools/local_llm/results/summary.md for how this profile scored):
#   source ~/.unsloth/studio/unsloth_studio/bin/activate
#   unsloth run --model /var/tmp/ollama-import/Qwen3.8-27B-IQ4_NL.gguf --max-seq-length 131072 \
#       --gpu-memory-mode manual --speculative-type mtp --spec-draft-n-max 3 \
#       --host 0.0.0.0 --port 8888 --parallel 1 --api-only --api-key-name bakeoff
#   (prints an sk-unsloth-... API key on first run under --api-key-name bakeoff, then REUSES that same key on
#   every later run with the same --api-key-name -- capture it once with `unsloth studio` or the printed banner
#   and put the literal value in a local, UNTRACKED env/secrets file; never commit it. This checked-in file only
#   names the env var, per the task's "record ... a token env var", not the secret itself.)
# STOP: `unsloth studio stop`
#
# LAN: --host 0.0.0.0 above binds all interfaces, but the workstation's ufw does NOT yet allow 8888/tcp from the
# LAN (checked 2026-09-29: only 3389, 8787, 11434 and KDE Connect are open). NOT opened by this task (firewall
# changes are the owner's call) -- run this yourself if LAN access is wanted:
#   sudo ufw allow from 192.168.0.0/24 to any port 8888 proto tcp comment 'Unsloth Studio LAN bake-off'
#
# AUTH: real bearer-token auth (unlike Ollama) -- every request needs `Authorization: Bearer sk-unsloth-...`.
ANTHROPIC_BASE_URL=http://192.168.0.68:8888
ANTHROPIC_MODEL=Qwen3.8-27B-IQ4_NL
ANTHROPIC_AUTH_TOKEN_ENV=UNSLOTH_STUDIO_API_KEY
# ^ the harness should read the real key from this env var (set it from your own untracked secrets, e.g.
#   ~/.config/unsloth/bakeoff.key, sourced separately) rather than a literal here.
