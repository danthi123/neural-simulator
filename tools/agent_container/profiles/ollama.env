# Backend profile: Ollama (native install, systemd service `ollama`, v0.34.4 -- >= the v0.14 that shipped
# Anthropic /v1/messages compatibility). Model imported from the SAME GGUF the llama-server default profile uses
# (no re-download): `ollama show qwen38-27b-iq4nl` for its num_ctx/sampling params (see
# tools/local_llm/results/summary.md for the bake-off numbers this profile was picked/rejected on).
#   set -a; source tools/agent_container/profiles/ollama.env; set +a
#
# LAN: OLLAMA_HOST=0.0.0.0:11434 is already set (systemd drop-in /etc/systemd/system/ollama.service.d/override.conf)
# and the workstation's ufw already allows 11434/tcp from 192.168.0.10 (the homelab server -- rule predates this
# bake-off, labeled "Ollama for homelab server"). For any OTHER LAN host, the owner must add a rule themselves,
# e.g.:
#   sudo ufw allow from 192.168.0.0/24 to any port 11434 proto tcp comment 'Ollama LAN bake-off'
#
# AUTH: Ollama has NO built-in API-key/bearer-token auth (confirmed against v0.34.4: it accepts any or no
# Authorization header). ANTHROPIC_AUTH_TOKEN is set below only because Claude Code requires some non-empty
# value -- it is NOT checked by the server. Anyone who can reach the port can use the model; restrict by network
# (the ufw rule above), not by key.
ANTHROPIC_BASE_URL=http://192.168.0.68:11434
ANTHROPIC_MODEL=qwen38-27b-iq4nl
ANTHROPIC_AUTH_TOKEN=local
