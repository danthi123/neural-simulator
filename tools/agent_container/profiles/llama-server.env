# Backend profile: today's default (llama-server via tools/local_llm/llm.sh, profiles.json ->
# qwen38-27b-iq4nl-mtp-128k-q4). Source this file, then run Claude Code / the harness against it:
#   set -a; source tools/agent_container/profiles/llama-server.env; set +a
#
# LAN NOTE: the live production instance is started by tools/local_llm/llm.sh with `--host 127.0.0.1`
# (workstation-local only, by design -- see docs/plans/2026-09-29-local-model-transition-PLAN.md section 9,
# which routes the container's harness through the workstation over SSH, not a direct model-server port).
# This base URL therefore only resolves FROM THE WORKSTATION ITSELF. If a container/remote harness needs to
# reach it directly instead, llm.sh would need `--host 0.0.0.0` added to its llama-server command in
# tools/local_llm/llm.sh's profile_cmd(), and the firewall opened (see ollama.env for the exact ufw form) --
# NOT done here, since this is today's unmodified default (task said: do not change it without confirmation).
ANTHROPIC_BASE_URL=http://127.0.0.1:8080
ANTHROPIC_MODEL=local
ANTHROPIC_AUTH_TOKEN=local
# No API-key support in llama-server itself; "local" is a dummy value Claude Code requires SOME token.
