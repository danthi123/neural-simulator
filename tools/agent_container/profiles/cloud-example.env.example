# tools/agent_container/profiles/cloud-example.env.example -- commented TEMPLATE for a cloud, Anthropic-
# compatible API backend (plan section 9: "a cloud API with an Anthropic-compatible endpoint later"). Not a
# live profile -- copy to e.g. `cloud.env` in this directory (or bake a real one into the image) and fill in
# real values to use it; `llm list` only shows *.env files, so this `.env.example` is inert on purpose.
#
# BASE_URL=https://api.example-provider.com          # any Anthropic Messages-API-compatible endpoint
# TOKEN_VAR=CLOUD_LLM_API_KEY                         # the NAME of an env var holding the real key -- set the
#                                                      # key itself via compose's `environment:`/`env_file:`
#                                                      # (or a docker secret), never written into this file.
# MODEL=claude-cloud-model-id
# CONTEXT=200000
# KIND=cloud                                          # tools/agent_gateway.sh `yield` and tools/game.sh skip
#                                                      # pausing the harness when the active profile is KIND=cloud
#                                                      # (queried via tools/agent_harness_ctl.sh `state`) -- a
#                                                      # cloud backend does not depend on the workstation's 3090.
