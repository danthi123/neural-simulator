# tools/agent_container/profiles/deepseek-flash.env -- cloud mechanical-tier profile (owner-approved 2026-09-29:
# "a cheap cloud model for the mechanical tier", docs/plans/2026-09-29-local-model-transition-PLAN.md section 9).
# DeepSeek publishes an Anthropic Messages-API-compatible endpoint that Claude Code (and this repo's own
# tools/agent_container/bin/llm) can talk to directly -- no SDK translation layer needed. Verified against
# DeepSeek's OWN docs (not inferred):
#   https://api-docs.deepseek.com/guides/anthropic_api/   -- base URL + auth
#   https://api-docs.deepseek.com/quick_start/pricing      -- model id + context window
#
# BASE_URL: DeepSeek's Anthropic-compatible endpoint (distinct from its native OpenAI-style
# https://api.deepseek.com/v1 -- do not use that one here, it does not speak the Anthropic Messages format).
BASE_URL=https://api.deepseek.com/anthropic

# TOKEN_VAR: the NAME of an env var holding the real key -- the key ITSELF goes in the server's ~/apps/.env as
# SIM_AGENT_DEEPSEEK_API_KEY (the stack fragment maps it in), never in this file.
TOKEN_VAR=DEEPSEEK_API_KEY

# MODEL: "deepseek-flash" is DeepSeek's own current alias for its fastest chat model (DeepSeek-V4.1-Flash as of
# this writing; DeepSeek's docs note older names deepseek-v4-flash / deepseek-v4-flash-vision-exp are retired
# and now redirect to the same model, so "deepseek-flash" is the name to use going forward).
MODEL=deepseek-flash

# CONTEXT: DeepSeek's pricing page lists a 1M-token context window for deepseek-flash (max output ~384K of
# that). Set conservatively at 1,000,000 -- Claude Code's own auto-compact should fire well before that anyway.
CONTEXT=1000000

# KIND=cloud: tools/agent_gateway.sh `yield` and tools/game.sh skip pausing the harness for a cloud profile --
# mechanical work routed here does not depend on the workstation's 3090 (cost-routing skill: CPU/cheap-model
# work should not compete with the GPU-bound driver for the shared card).
KIND=cloud
