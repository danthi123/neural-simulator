# tools/agent_container/profiles/glm-lite.env -- ALTERNATIVE cloud mechanical-tier profile (owner-approved
# 2026-09-29, alongside deepseek-flash.env; see that file's header for the shared background). Z.ai (Zhipu AI)
# also publishes an Anthropic Messages-API-compatible endpoint. Verified against Z.ai's OWN docs (not inferred):
#   https://docs.z.ai/devpack/tool/others   -- Anthropic-compatible base URL
#   https://docs.z.ai/guides/overview/pricing -- model ids + pricing tier
#   https://docs.z.ai/guides/llm/glm-4.7      -- context window for the glm-4.7 family
#
# NOTE ON THE NAME: Z.ai has no model literally called "GLM Lite" -- their lightweight/cheap tier is named
# glm-4.7-flashx ($0.07/$0.40 per MTok in/out, "lightweight, high-speed, affordable" per Z.ai's own pricing
# page). This file is named glm-lite.env because that is the ROLE it fills here (the cheap alternative to
# deepseek-flash for mechanical-tier work), not a product name. Two close alternatives if this one does not fit:
#   glm-4.7-flash   -- Z.ai's completely FREE tier (same family); fine for low-stakes/low-volume work, but a
#                      free tier typically carries tighter rate limits / lower priority under load.
#   glm-4.5-air     -- a larger, still-cheap model ($0.20/$1.10 per MTok) if flashx's quality is not enough.
# Change MODEL below to try either; nothing else in this file needs to change.
#
# BASE_URL: Z.ai's international Anthropic-compatible endpoint. Z.ai also publishes a mainland-China endpoint
# (open.bigmodel.cn/api/anthropic) for accounts registered there -- use that instead if that is where the
# account lives; the rest of this file is identical either way.
BASE_URL=https://api.z.ai/api/anthropic

# TOKEN_VAR: the NAME of an env var holding the real key -- the key ITSELF goes in the server's ~/apps/.env as
# SIM_AGENT_GLM_API_KEY (the stack fragment maps it in), never in this file.
TOKEN_VAR=GLM_API_KEY

# MODEL: see "NOTE ON THE NAME" above.
MODEL=glm-4.7-flashx

# CONTEXT: 200K tokens per Z.ai's glm-4.7 family documentation.
CONTEXT=200000

# KIND=cloud: see deepseek-flash.env's comment -- no GPU-yield/gaming pause needed for cloud traffic.
KIND=cloud
