    "gpe_S": {
      "x":   3.0, "y": -2.0, "z": -1.0, "r": 0.6, "family": "pallidum",
      "display_name": "GPe S",
      "function": "Indirect-pathway relay",
      "neurons": 25,
      "description": "External globus pallidus for SOUTH channel. Tonically active; relays D2 inhibition into the indirect pathway."
