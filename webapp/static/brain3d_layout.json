    "str_D1_S": {
      "x":   1.0, "y":  0.5, "z": -1.0, "r": 0.8, "family": "d1",
      "display_name": "D1 striatum S",
      "function": "DIRECT pathway (Go-S)",
      "neurons": 50,
      "description": "Direct-pathway striatal MSNs for SOUTH. D1-receptor expressing MSNs. The 'go' signal for south actions."
