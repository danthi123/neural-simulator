{
  "_comment": "3D positions, display names, and descriptions for every brain region. Coordinates: +X = info flow (input left, output right); +Y = dorsal (cortex up, subcortical down); +Z = action channel index (N=front, W=back). The display_name is what shows on the 3D label (concise, plain-language). The description appears in the hover tooltip / detail panel.",
  "_units": "Arbitrary 3D units; fits in a roughly [-12, 12] cube",
  "regions": {
    "retina": {
      "x": -10.0, "y":  0.5, "z":  0.0, "r": 1.4, "family": "sensory",
      "display_name": "Retina",
      "function": "Visual input",
      "neurons": 2048,
      "description": "32x32 ON + 32x32 OFF channels. Sees the gridworld image — light pixels excite ON cells, dark pixels excite OFF cells. The sole entry point for visual information."
    },
    "cortex_v1_simple": {
      "x":  -8.5, "y":  1.5, "z":  0.0, "r": 1.2, "family": "v1",
      "display_name": "V1 simple (Edges)",
      "function": "Oriented edge detection",
      "neurons": 1024,
      "description": "Primary visual cortex simple cells with Gabor receptive fields. Each neuron prefers a specific edge orientation (horizontal, vertical, diagonal) at a specific retinal location. Hubel-Wiesel 1962."
    },
    "cortex_v1_complex": {
      "x":  -7.0, "y":  2.0, "z":  0.0, "r": 1.0, "family": "v2",
      "display_name": "V1 complex",
      "function": "Phase-invariant edges",
      "neurons": 512,
      "description": "Pools simple-cell responses across retinal positions, so neurons fire for any edge of the right orientation regardless of exact location. Position-invariant edge detection."
    },
    "cortex_v2": {
      "x":  -5.5, "y":  2.5, "z":  0.0, "r": 0.9, "family": "v2",
      "display_name": "V2 (Shapes)",
      "function": "Feature integration",
      "neurons": 256,
      "description": "Combines edges into shapes — corners, contours, simple objects. The bridge between low-level vision (V1) and high-level recognition (IT)."
    },
    "cortex_it": {
      "x":  -4.0, "y":  3.0, "z":  0.0, "r": 0.7, "family": "it",
      "display_name": "IT (Objects)",
      "function": "Object identity",
      "neurons": 64,
      "description": "Inferotemporal cortex. High-level visual representation: 'I see the agent', 'I see the goal'. Provides object identity to the rest of the brain."
    },
    "cortex_N": {
      "x":  -1.5, "y":  3.5, "z":  3.0, "r": 0.7, "family": "premotor",
      "display_name": "Premotor N",
      "function": "Action proposal: NORTH",
      "neurons": 25,
      "description": "Premotor cortex for the NORTH action. One of four competing pools — when this one wins (via basal-ganglia gating), the agent moves north."
    },
    "cortex_E": {
      "x":  -1.5, "y":  3.5, "z":  1.0, "r": 0.7, "family": "premotor",
      "display_name": "Premotor E",
      "function": "Action proposal: EAST",
      "neurons": 25,
      "description": "Premotor cortex for the EAST action. Competes with cortex_N/S/W; the basal-ganglia loop selects one winner per step."
    },
    "cortex_S": {
      "x":  -1.5, "y":  3.5, "z": -1.0, "r": 0.7, "family": "premotor",
      "display_name": "Premotor S",
      "function": "Action proposal: SOUTH",
      "neurons": 25,
      "description": "Premotor cortex for the SOUTH action. Competes with cortex_N/E/W; the basal-ganglia loop selects one winner per step."
    },
    "cortex_W": {
      "x":  -1.5, "y":  3.5, "z": -3.0, "r": 0.7, "family": "premotor",
