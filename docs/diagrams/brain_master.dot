// ============================================================================
//  SIMULATED-BRAIN ARCHITECTURE — MASTER MAP  (as actually implemented)
//  Source spec: research/findings/2026-06-09-brain-architecture-flowchart-spec.md
//  Render:  dot -Tpng -Gdpi=140 brain_master.dot -o brain_master.png
//           dot -Tsvg          brain_master.dot -o brain_master.svg
//
//  CLUSTER-LEVEL overview. Each box is one subsystem; the two exhaustive
//  per-region graphs are brain_navigation.dot and brain_conversational.dot.
//  The whole brain is ONE SimulationBridge engine assembled per-config from a
//  declarative region/pathway grammar; "navigation" and "conversational" are
//  two alternative configurations of that one substrate. They now also share
//  ONE running bridge (consolidation) AND functionally interact through THREE
//  validated cross-brain synaptic routes (all 6/6-seed GO):
//    (A) command_route        language -> action  (spoken-instruction nav)
//    (B) cortex_it->lang_out  perception -> memory RECALL (navigate-to-see)
//    (C) grounded code         compose-perceived  (navigate-to-compose; the
//                              live cortex_it rate is projected to a phasor the
//                              composer binds — dissolving the rate↔phasor wall)
//  Plus a co-resident, opt-in GENERALIZATION stack (gen_perception ->
//  gen_concept(NMDA) -> gen_fact) that lets a NOVEL perceived object be
//  recognised by category, the path to generalize across SIMILAR concepts on
//  the point-neuron substrate. These cross-brain routes + the gen stack are
//  added by specific runners ON TOP of a builder, not part of either builder's
//  own exhaustive per-region graph.
// ============================================================================
digraph BrainMaster {
    rankdir=TB;
    newrank=true;
    compound=true;
    splines=spline;
    nodesep=0.34;
    ranksep=0.42;
    bgcolor="white";
    fontname="Helvetica";
    labelloc="t";
    fontsize=26;
    pad="0.15,0.08";
    label=<<B>Simulated-brain architecture — master map</B><BR/><FONT POINT-SIZE="13.5">ONE brain (one network, one update loop): a NAVIGATION half and a CONVERSATION half as separate groups of neurons on the same substrate<BR/><FONT POINT-SIZE="12">they interact through THREE validated synaptic routes — A: a spoken word steers the body · B: navigate to SEE an object then RECALL it · C: bind a PERCEIVED object into a new fact<BR/>navigation decides which way to move by a spiking race (no hand-coded shortcut) · conversation answers "I don't know" rather than inventing (the no-confabulation safeguard)<BR/>honest map of the code, including its simplifications (faithful-vs-shortcut layer)</FONT></FONT>>;

    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11.5, margin="0.16,0.10", penwidth=1.6];
    edge [fontname="Helvetica", fontsize=9.5, color="#34495e", penwidth=1.5];

    // ========================================================================
    //  NAVIGATION supergroup  (build_bg_brain_regions) — left
    // ========================================================================
    subgraph cluster_nav {
        labelloc="t"; labeljust="l";
        label=<<B>NAVIGATION supergroup</B>  ·  build_bg_brain_regions()  ·  the action-selection brain>;
        style="rounded,filled"; color="#b9770e"; fillcolor="#fffaf2"; fontcolor="#9a6608"; fontsize=15; penwidth=2.0; margin=14;

        nav_in [label=<<B>Perception read-outs</B>  (C7p)<BR/>place · goal · sensory · beacon · landmark<BR/><FONT POINT-SIZE="8.5">⌂ sensory input the world renders for the agent</FONT>>, fillcolor="#fdebd0", color="#ca6f1e", fontcolor="#5b3a10"];
        sc_orient [label=<<B>Orienting (superior colliculus)</B>  (C5)<BR/>a spiking "look-here" bump → cortex<BR/><FONT POINT-SIZE="8.5">retinotopic, lateral-inhibition map (Mexican-hat)</FONT>>, fillcolor="#e8daef", color="#7d3c98", fontcolor="#3e1f4d"];
        m1     [group="spine", label=<<B>Motor cortex</B>  (C2)<BR/>one pool per direction — N/E/S/W (×4)<BR/><FONT POINT-SIZE="8.5">⚠ one-line-per-action split (stand-in)</FONT>>, fillcolor="#e8e1f2", color="#5b4a8a", fontcolor="#2c2547"];
        bg     [group="spine", label=<<B>Basal ganglia — action selection</B>  (C3)<BR/>direct "go" ⊣ · indirect "no-go" · hyperdirect<BR/>(×4 per direction)<BR/><FONT POINT-SIZE="8.5"><B>the decision heart · where it learns</B></FONT>>, fillcolor="#f5cba7", color="#a04000", fontcolor="#5a2400"];
        reward [label=<<B>Reward &amp; dopamine</B>  (C6)<BR/>reward neurons ▶ <B>dopamine cells</B><BR/>value estimate ⊣<FONT COLOR="#7d3c98"><B>(slow inhib.)</B></FONT> → dopamine · error = reward − value<BR/><FONT POINT-SIZE="8.5">spiking actor-critic (all neural)</FONT>>, fillcolor="#fdebd0", color="#b9770e", fontcolor="#5b3a10"];
        thal   [group="spine", label=<<B>Thalamus (relay) + reticular gate</B>  (C4)<BR/>relay per direction (×4)<BR/><FONT POINT-SIZE="8.5">basal-ganglia silence releases the relay</FONT>>, fillcolor="#d0ece7", color="#148f77", fontcolor="#0a4034"];
        sc     [group="spine", label=<<B>Spiking decision — accumulate → commit</B>  (C5)<BR/>evidence builds up → an all-or-none "commit" burst picks the move (×4)<BR/><FONT POINT-SIZE="8.5"><B>DEFAULT: the move emerges from the spiking race</B> (Wang-2002 + Lo-Wang)<BR/>the hand-coded argmax is RETIRED · 6/6-seed GO · 100% commit-burst</FONT>>, fillcolor="#e3d4ef", color="#7d3c98", fontcolor="#3e1f4d", penwidth=2.4];
        cb     [label=<<B>Cerebellum</B>  (C8)<BR/>sparse coding → Purkinje ⊣ deep nucleus<BR/><FONT POINT-SIZE="8.5">Marr-Albus-Ito · opt-in</FONT>>, fillcolor="#d4e6f1", color="#2e6da4", fontcolor="#163a59"];
        wm_nav [label=<<B>Working memory (prefrontal)</B>  (C9)<BR/>holds the goal (self-sustaining activity)>, fillcolor="#d4e6f1", color="#2e86c1", fontcolor="#16435f"];

        // -- navigation perception→action spine (kept inside the cluster) --
        nav_in -> m1   [label="learned\nplace→action"];
        nav_in -> sc_orient [label="retinal\nimage", style=dashed, color="#7d3c98"];
        sc_orient -> m1 [label="look-here bump\n→ direction", color="#7d3c98"];
        m1     -> bg   [label="cortex→striatum\n(dopamine-gated learning)", penwidth=2.4];
        bg     -> thal [label="silence the gate\n(release the relay)", arrowhead=tee, color="#922b21", penwidth=2.4];
        thal   -> sc   [label="relay → decision"];
        sc     -> motor[label="commit fires\n→ the move", penwidth=2.2];
        thal   -> motor[label="relay → motor\n(host-argmax oracle path)", style=dashed, penwidth=1.6];
        cb     -> motor[label="cerebellum → motor", color="#2e6da4"];
        wm_nav -> m1   [label="goal bias", style=dashed];

        // reward loop
        bg     -> reward [label="state → dopamine cells", arrowhead=tee, color="#922b21"];
        reward -> bg     [label="dopamine signal\nreinforces what just fired", style=dotted, color="#d98008", arrowhead=odiamond, penwidth=2.6, fontcolor="#9a6608", constraint=false, weight=5];

        // keep NAV to ~2 columns: stack the flank nodes (orient / WM / reward /
        // cerebellum) into one side column beside the spine (visual ordering
        // only — content unchanged) so the cluster is a narrow strip.
        sc_orient -> wm_nav [style=invis, weight=30];
        wm_nav    -> reward [style=invis, weight=30];
        reward    -> cb     [style=invis, weight=30];
    }

    // ========================================================================
    //  SHARED region types  (built by BOTH configs) — center spine
    // ========================================================================
    subgraph cluster_shared {
        labelloc="t"; labeljust="l";
        label=<<B>SHARED region types</B>  ·  built (as the same type) by BOTH configs>;
        style="rounded,filled"; color="#566573"; fillcolor="#f4f6f7"; fontcolor="#34495e"; fontsize=15; penwidth=2.0; margin=14;

        visual [label=<<B>Vision — "what is it" stream</B>  (C1)<BR/>retina → edges (V1) → shapes (V2) → objects (IT)<BR/><FONT POINT-SIZE="8.5">recognises objects · opt-in</FONT>>, fillcolor="#d4e6f1", color="#2e6da4", fontcolor="#163a59"];
        hippo  [label=<<B>Hippocampus (memory)</B>  (C7)<BR/>entorhinal → dentate ⊣ CA3 ⟲ → CA1<BR/><FONT POINT-SIZE="8.5">separates · completes · replays during "sleep"</FONT>>, fillcolor="#d9ead3", color="#5a8a3c", fontcolor="#2c4a1c"];
        lang_in[label=<<B>Words in (hearing)</B>  (C11)<BR/>language input region<BR/><FONT POINT-SIZE="8.5">⌂ word encoding (input boundary)</FONT>>, fillcolor="#d4e6f1", color="#2471a3", fontcolor="#123a55"];
        motor  [group="spine", label=<<B>Motor output</B>  (C10)<BR/>one pool per direction — N/E/S/W (×4)<BR/><FONT POINT-SIZE="8.5">the body moves the way the firing pool says</FONT>>, fillcolor="#f5b7b1", color="#c0392b", fontcolor="#641e16"];
        lang_out[label=<<B>Words out (speaking)</B>  (C11)<BR/>language output region<BR/><FONT POINT-SIZE="8.5">⌂ word read-out (output boundary)</FONT>>, fillcolor="#d4e6f1", color="#2471a3", fontcolor="#123a55"];

        // compact 2-column block (visual ordering only — content unchanged):
        // col-A visual→hippo · col-B lang_in→motor→lang_out. motor sits
        // mid-column so the spine sc→motor→conversation runs straight through it;
        // SHARED stays SHORT so it stacks cleanly under NAVIGATION.
        visual  -> hippo    [style=invis, weight=30];
        lang_in -> motor    [style=invis, weight=30];
        motor   -> lang_out [style=invis, weight=30];
    }

    // ========================================================================
    //  CONVERSATIONAL supergroup  (build_biological_brain_regions) — right
    // ========================================================================
    subgraph cluster_conv {
        labelloc="t"; labeljust="l";
        label=<<B>CONVERSATION supergroup</B>  ·  the production pipeline (OneBrainComposer)  ·  the language brain>;
        style="rounded,filled"; color="#2471a3"; fillcolor="#f3f8fc"; fontcolor="#1a5276"; fontsize=15; penwidth=2.0; margin=14;

        cortex320 [group="spine", label=<<B>Learned word-meaning cortex</B>  (C11)<BR/>320 concepts · <B>learned from a conversation stream</B><BR/><FONT POINT-SIZE="8.5">similar words sit close together (so it can generalize)</FONT>>, fillcolor="#d6eaf8", color="#21618c", fontcolor="#10303f", penwidth=1.8];
        parser   [group="spine", label=<<B>Comprehension — sentence parser</B>  (C11)<BR/>word order → who-did-what (agent / action / patient)<BR/><FONT POINT-SIZE="8.5">voice-invariant · flexible frames (S-V-O / V-S-O / O-S-V, auto-picked)</FONT>>, fillcolor="#d6eaf8", color="#2e86c1", fontcolor="#163a59", penwidth=1.8];
        composer [group="spine", label=<<B>Composer — bind words into a fact</B>  (C11)<BR/>phase-based "resonate-and-fire" neurons + complex synapses<BR/><FONT POINT-SIZE="8.5">handles attributes ("big apple"), negation, embedded clauses · ~10–20× faster<BR/>⚠ binding rule is fixed algebra (stand-in for a learned cortex — step 3)</FONT>>, fillcolor="#d6eaf8", color="#2874a6", fontcolor="#143a54", penwidth=2.0];
        store    [label=<<B>Fact store</B>  (in synapses)<BR/>each fact = a pattern written into complex synapses<BR/><FONT POINT-SIZE="8.5">persistent · holds many facts</FONT>>, fillcolor="#d4e6f1", color="#21618c", fontcolor="#10303f"];
        recall   [group="spine", label=<<B>Recall &amp; answer</B>  ·  <B>no-confabulation safeguard</B><BR/>who/what · yes-no · multi-hop reasoning · multi-turn dialogue<BR/><FONT POINT-SIZE="8.5"><B>answers "I don't know" rather than inventing</B> (learned familiarity gate)</FONT>>, fillcolor="#d6eaf8", color="#1a5276", fontcolor="#0c2533", penwidth=2.2];
        dlg      [label=<<B>Dialogue planning (prefrontal)</B>  (C9)<BR/>picks the next on-topic thing to say<BR/><FONT POINT-SIZE="8.5">self-sustaining working memory</FONT>>, fillcolor="#d4e6f1", color="#2e86c1", fontcolor="#16435f"];
        produce  [group="spine", label=<<B>Reply — word-ordered output</B>  (C10/C11)<BR/>a spiking "say-this-first" ranking orders the words<BR/><FONT POINT-SIZE="8.5">competitive-queuing serial order (not a host template)</FONT>>, fillcolor="#d6eaf8", color="#2e86c1", fontcolor="#163a59"];

        // -- conversational production pipeline (top→bottom) --
        cortex320 -> parser  [label="word meanings"];
        parser    -> composer[label="who-did-what\n→ bind"];
        composer  -> store   [label="write the fact", arrowhead=normal];
        store     -> recall  [label="look up / match a cue", constraint=false, weight=6];
        composer  -> recall  [label="unbind\n+ clean up"];
        recall    -> produce [label="answer\n(or abstain)"];
        dlg       -> produce [label="next thing\nto say", style=dashed, constraint=false, weight=0];
        // keep CONV to a narrow strip: tuck the flank nodes (store / dialogue)
        // beside the spine (visual ordering only — content unchanged).
        store -> dlg [style=invis, weight=30];
        recall -> store [style=invis, weight=30];
    }

    // ========================================================================
    //  GENERALIZATION stack  (perceive a NOVEL object → recognise its category)
    //  Co-resident opt-in, appended by nav_conv_merged_bridge / the genfrontier
    //  runners on top of a builder (NOT part of either per-builder graph). The
    //  one path to generalize across SIMILAR concepts on the point-neuron
    //  substrate (no dendritic rewrite): local structure + Hebbian convergence.
    // ========================================================================
    subgraph cluster_gen {
        labelloc="t"; labeljust="l";
        label=<<B>GENERALIZATION</B>  ·  recognise a NOVEL object by its category, then answer about it  ·  co-resident opt-in>;
        style="rounded,filled,dashed"; color="#7d6608"; fillcolor="#fcf8ee"; fontcolor="#6a5407"; fontsize=15; penwidth=2.0; margin=14;

        gen_perc [group="spine", label=<<B>Structured perception</B><BR/>seen through the edge-detectors (V1)<BR/><FONT POINT-SIZE="8.5">similar shapes → similar codes</FONT>>, style="rounded,filled,dashed", fillcolor="#d4e6f1", color="#2e6da4", fontcolor="#163a59"];
        gen_conc [group="spine", label=<<B>Concept neurons</B>  ⟲<BR/>fire for the matching <B>category</B><BR/><FONT POINT-SIZE="8.5">slow integration lets a faint percept reach firing</FONT>>, style="rounded,filled,dashed", fillcolor="#d6eaf8", color="#21618c", fontcolor="#10303f"];
        gen_fact [group="spine", label=<<B>Which category fired</B><BR/>readable by downstream neurons<BR/><FONT POINT-SIZE="8.5">→ recall a fact about that category</FONT>>, style="rounded,filled,dashed", fillcolor="#d6eaf8", color="#21618c", fontcolor="#10303f"];

        gen_perc -> gen_conc [label=<<B>learned link</B>  ⊟<BR/><FONT POINT-SIZE="8">"fire-together-wire-together"</FONT>>, color="#1a9850", fontcolor="#0c5a28", penwidth=2.2];
        gen_conc -> gen_fact [label="category\n(fixed wiring)"];
    }

    // ========================================================================
    //  CROSS-SUPERGROUP arteries (drawn AFTER the clusters)
    //  All marked constraint=false so they are DRAWN but do not pull the
    //  vertically-stacked clusters sideways.
    // ========================================================================
    // shared language_input feeds both the conversational stack and (the bridge) navigation
    //  constraint=false + weight=0 → these are DRAWN but exert NO pull on node
    //  X-placement (otherwise they staircase the clusters apart). Cluster
    //  X-alignment is instead enforced by the explicit left/center/right rail
    //  ladder below.
    lang_in  -> cortex320 [label="words → meanings", lhead=cluster_conv, constraint=false, weight=0];
    produce  -> lang_out  [label="spoken reply", style=dashed, constraint=false, weight=0];
    recall   -> lang_out  [label="answer / 'I don't know'", constraint=false, weight=0];
    // (the visual ventral stream's link INTO the composer is the labelled (C) bridge below)

    // navigation perception readouts come from the shared hippocampus
    nav_in -> hippo  [label="place readout", dir=back, color="#5a8a3c", constraint=false, weight=0];
    // hippocampal consolidation into cortex (shared, both configs)
    hippo  -> cortex320 [label="sleep-replay\nconsolidation", color="#5a8a3c", constraint=false, weight=0];
    hippo  -> motor     [label="memory → motor", color="#5a8a3c", style=dashed, constraint=false, weight=0];

    // GENERALIZATION stack is fed by the visual ventral stream's Gabor/V1 (structured perception)
    visual -> gen_perc [label="edge-detectors →\nstructured perception", color="#2e6da4", style=dashed, constraint=false, weight=0];
    // the generalizing concept→fact spikes KEY the composer's recall + no-confab safeguard (the verbalize
    // capstone HYBRID: the spiking concept-category keys the validated phasor composer → naming)
    gen_fact -> recall [label="recognised category\n→ recall a fact about it", color="#7d6608", style=dashed, constraint=false, weight=0];

    // ===== THE FUNCTIONAL CROSS-BRAIN BRIDGES (real cross-region synaptic interaction) =====
    // (A) LANGUAGE→ACTION. language_input -> cortex_{N,E,S,W} (LEARNED word->action route),
    // gated by command_route, opened by the parser's action-role FIRING. Spoken-instruction
    // navigation, 6/6-seed GO. The first validated synaptic link between the brains.
    lang_in -> m1 [label=<<B>A · a spoken word steers the body</B>  ⊟<BR/><FONT POINT-SIZE="8">learned word→action route · opened by comprehension · 6/6-seed GO</FONT>>,
                   color="#1a9850", fontcolor="#0c5a28", penwidth=3.0, style=bold, constraint=false, weight=0];

    // (B) PERCEPTION→MEMORY (recall). A perceived object's IT ("what") ensemble is engram-tagged
    // in-episode; later neural reactivation reads it through a TRAINED IT -> language_output route
    // -> "I saw the apple". navigate-to-see-then-answer, 6/6-seed GO. RECALL (not compose).
    visual -> lang_out [label=<<B>B · see an object, later RECALL it</B><BR/><FONT POINT-SIZE="8">vision → words route + memory tag · navigate-to-see · 6/6-seed GO</FONT>>,
                   color="#1a9850", fontcolor="#0c5a28", penwidth=2.6, style=bold, constraint=false, weight=0];

    // (C) COMPOSE-PERCEIVED. The LIVE IT spiking RATE of a perceived object is mapped by a FIXED
    // complex projection into a unit PHASOR (host arithmetic on the substrate's own live rate),
    // so the percept enters the composer's bind/recall algebra. Dissolves the rate-vs-phasor
    // mismatch for perceived-object facts. navigate-to-compose-then-answer, 6/6-seed GO.
    visual -> composer [label=<<B>C · bind a PERCEIVED object into a new fact</B>  ⚠<BR/><FONT POINT-SIZE="8">a seen object's firing → a code the composer can bind · navigate-to-compose · 6/6-seed GO</FONT>>,
                   color="#1a9850", fontcolor="#0c5a28", penwidth=2.6, style="bold,dashed", constraint=false, weight=0];

    // ===== VERTICAL STACKING of the four supergroups =======================
    //  Instead of pinning nodes from DIFFERENT clusters side by side (which
    //  forced the old super-wide layout), the four supergroups are chained into
    //  ONE straight vertical SPINE (functional order: NAVIGATION → SHARED →
    //  CONVERSATIONAL → GENERALIZATION → legend) via a high-weight invisible
    //  rail through each cluster's group="spine" node. Each cluster's own
    //  internal edges keep it a vertical pipeline; its non-spine nodes flank
    //  the spine, so the whole map is a narrow scrollable ribbon.
    //  Spine chain (real + rail): m1→bg→thal→sc (NAV, real) ─sc→motor (real)─
    //  motor→cortex320→parser→composer→recall→produce (CONV, real) → gen_perc→
    //  gen_conc→gen_fact (GEN, real) → leg.
    //  The bottom→top rails push each WHOLE cluster below the previous one
    //  (not merely beside it).
    motor    -> cortex320 [style=invis, weight=80];   // SHARED spine → CONVERSATION spine
    produce  -> gen_perc  [style=invis, weight=80];   // CONVERSATION spine → GENERALIZATION spine
    gen_fact -> leg       [style=invis, weight=80];    // GENERALIZATION spine → legend

    // ===== LEGEND ==========================================================
    subgraph cluster_legend {
        label=""; style="rounded,filled"; color="#566573"; fillcolor="#ffffff"; penwidth=1.6; margin=10;
        leg [shape=plaintext, fillcolor="white", label=<
          <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3">
            <TR><TD ALIGN="LEFT" COLSPAN="2"><B>How to read this map — box colour = which half builds it</B></TD></TR>
            <TR><TD ALIGN="RIGHT" BGCOLOR="#fdebd0" WIDTH="22"> </TD><TD ALIGN="LEFT">NAVIGATION half</TD></TR>
            <TR><TD ALIGN="RIGHT" BGCOLOR="#d4e6f1" WIDTH="22"> </TD><TD ALIGN="LEFT">SHARED — used by both halves</TD></TR>
            <TR><TD ALIGN="RIGHT" BGCOLOR="#d6eaf8" WIDTH="22"> </TD><TD ALIGN="LEFT">CONVERSATION half</TD></TR>
            <TR><TD ALIGN="RIGHT" BGCOLOR="#fcf8ee" WIDTH="22"> </TD><TD ALIGN="LEFT">GENERALIZATION — co-resident, opt-in</TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2"> </TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2"><B>what each arrow carries</B>  (it points downstream)</TD></TR>
            <TR><TD ALIGN="RIGHT">──▶</TD><TD ALIGN="LEFT">excitation — "fire more" (glutamate)</TD></TR>
            <TR><TD ALIGN="RIGHT"><FONT COLOR="#922b21">──⊣</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#922b21">fast inhibition — "fire less" (GABA-A)</FONT></TD></TR>
            <TR><TD ALIGN="RIGHT"><FONT COLOR="#7d3c98">- -⊣</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7d3c98">slow inhibition (GABA-B) — the one signature "value subtraction" edge</FONT></TD></TR>
            <TR><TD ALIGN="RIGHT"><FONT COLOR="#d98008">····◆</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#d98008">dopamine — a reinforcement signal sprayed widely (not a wire)</FONT></TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#1a9850"><B>━━▶ the two halves interact through these routes (each 6/6-seed GO):</B></FONT></TD></TR>
            <TR><TD ALIGN="RIGHT"><FONT COLOR="#1a9850"><B>━━▶</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a9850"><B>A</B> a spoken word steers the moving body</FONT></TD></TR>
            <TR><TD ALIGN="RIGHT"><FONT COLOR="#1a9850"><B>━━▶</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a9850"><B>B</B> navigate to SEE an object, then RECALL what was seen</FONT></TD></TR>
            <TR><TD ALIGN="RIGHT"><FONT COLOR="#1a9850"><B>━ ▶</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a9850"><B>C</B> bind a PERCEIVED object into a new fact</FONT></TD></TR>
            <TR><TD ALIGN="RIGHT">- -</TD><TD ALIGN="LEFT">weaker / feedback / optional pathway</TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2"> </TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2"><B>honesty markers</B>   (full detail: the two detail diagrams + the spec)</TD></TR>
            <TR><TD ALIGN="RIGHT">⌂</TD><TD ALIGN="LEFT">input/output boundary — the world renders what the agent senses, the body acts on its output (LEGITIMATE, not a shortcut)</TD></TR>
            <TR><TD ALIGN="RIGHT"><FONT COLOR="#b9770e">⚠</FONT></TD><TD ALIGN="LEFT">a documented SHORTCUT — a simplified stand-in, or a step still done by host maths instead of neurons</TD></TR>
            <TR><TD ALIGN="RIGHT">⊟</TD><TD ALIGN="LEFT">a switchable gate that opens/closes a route at run time</TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2"><B>no-confabulation safeguard</B> = the conversation answers "I don't know" instead of guessing</TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2">simplifications everywhere: point neurons (no dendrites) · one-step delays · simplified</TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2">neuron + synapse models (the full list SH-1…SH-14 is in the spec)</TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2"><B>ONE brain</B> = nav + conversation on one network, one update loop. The conversation half is held</TD></TR>
            <TR><TD ALIGN="LEFT" COLSPAN="2">frozen during navigation so its memory can't drift; the A/B/C routes + generalization are opt-in add-ons.</TD></TR>
          </TABLE>>];
    }
}
