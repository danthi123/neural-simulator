# Simulation output directories (profiles tracked, but auto-tuned overrides are machine-specific)
simulation_profiles/auto_tuned_overrides.json
simulation_checkpoints_h5/
simulation_recordings_h5/

# Development artifacts
WARP.md
previous versions/
benchmarks/
*_backup_*.py

# Temporary files
*.tmp
*.log

# Experiment and benchmark output (transient)
experiment_log_*.json
experiment_associative_*.json
experiment_stimulus_response_*.json
experiment_freq_response_*.json
experiment_rl_*.json
freq_test_*.json
sync_test*.json
sweep_*.json
sweep_*.csv
benchmark_results_*.json
*_summary.json
*_freq_data.json
startup_debug.txt

# Claude Code — ignore everything in .claude/ EXCEPT shared skills
.claude/*
!.claude/skills/
!.claude/skills/**

# Test output (transient)
tests/validation_results.json
tests/example_validation_results.json
tests/VALIDATE_GPU_README.md
tests/VALIDATE_QUICKSTART.md
tests/VALIDATION_SUITE_INDEX.md

# OS
.DS_Store
Thumbs.db
webapp/runtime/

# Reference textbook PDFs (large binaries; not source). The catalog
# session reads them locally; only the extracted markdown catalogs
# under references/ are committed.
references/textbooks/**/*.pdf

# Skill-system file — auto-generated by Claude Code skill loader; not
# project source.
AGENTS.md

# Webapp / runner verification screenshots — generated by Playwright
# automation when validating UI changes. Useful as ad-hoc evidence
# during sessions but not source. Whitelist exceptions for docs/
# and references/ (where deliberate diagrams live).
*.png
!docs/**/*.png
!references/**/*.png

# Playwright MCP cache (used for webapp UI verification)
.playwright-mcp/

# Runtime lineage storage (per-user; not source). Each lineage is
# a SimulationBridge state on disk plus metadata.json + history/
# snapshots. Created at runtime by chat_repl + BridgeMemory.
bridges/lineage/

# Runtime synapse shard storage (Phase 3 SSD paging). Per-pathway
# .npz files written by TieredSynapseStore. Regenerable from bridge
# state; not source.
bridges/synapse_shards/

# Webapp runtime artifacts (logs, restart helpers)
webapp_restart*.log
webapp_restart*.log.err
webapp/runtime/run_*.log

# Regenerable public-dataset cache (MNIST .npz, ~11 MB binary).
# Fetched ONCE at runtime from the canonical TF/Keras public mirror
# by dendritic_fair_gate, then cached locally. Self-contained at
# runtime via this cache; regenerable from the public mirror; not
# source (mirrors the corpus cache discipline).
data/mnist.npz

# Regenerable public-dataset caches (CIFAR-10 .npz, ~150 MB binary, etc.).
# Fetched/built ONCE at runtime and cached locally; regenerable; not source.
# Kept local (exceeds github's 100 MB blob limit) -- never commit.
data/cifar10/
data/*.npz

# Regenerable public-corpus cache (TinyStories/WikiText, ~20 MB plain text).
# Fetched ONCE at runtime from the canonical HuggingFace/GitHub public
# mirror by research/runners/corpus_fetch.py, then cached locally.
# Regenerable from the public mirror; not source.
data/corpus/

# torch checkpoints (large, regenerable build artifacts -- kept local, not committed)
*.ckpt.pt
*.pt

# bridge state snapshots (large local build artifacts -- regenerable, kept local)
*.simstate.h5
